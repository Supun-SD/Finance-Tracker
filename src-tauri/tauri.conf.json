{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finance Tracker",
  "version": "0.1.4",
  "identifier": "com.supun.finance-tracker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Finance Tracker",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDOTBDOTZGRTJEQzMwOUUKUldTZU1OemliOG1RckVSeTl1bDJGSFBrcnk0eDdIdUZSUE1QTlFSSzlrU1BPeHQ1bFg3TzBzVXkK",
      "endpoints": [
        "https://github.com/Supun-SD/finance-tracker/releases/latest/download/latest.json"
      ]
    }
  }
}